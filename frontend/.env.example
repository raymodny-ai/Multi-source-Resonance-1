# Frontend environment overrides — copy to .env (gitignored) and customize.
# Variables prefixed with VITE_ are baked into the build at `npm run build`
# and exposed to the browser via import.meta.env.VITE_*. Anything else
# stays server-side only.

# Backend API base URL (no trailing slash). Used by axios client.
# - Dev with Vite proxy: leave empty (axios uses same-origin /api/* paths)
# - Prod behind nginx: leave empty (reverse-proxied)
# - Standalone (open the built HTML directly): set to http://localhost:8525
VITE_API_BASE_URL=

# WebSocket port fallback. Used when the page is loaded WITHOUT the Vite dev
# proxy in front (e.g. opening `http://localhost:8525/` directly, or running
# the production build under nginx without a /ws proxy). Default: 8525
# (MSR-1 v4.0 backend). Legacy MSR (port 8524) was retired 2026-07-25.
VITE_WS_PORT=8525

# Default Spark Design theme. Options: light, dark, light-parchment, dark-parchment
VITE_DEFAULT_THEME=dark

# Default Spark Design layout scale. Options: neutral, compact, soft, sharp, dense
VITE_DEFAULT_STYLE=neutral