# ============================================================
# Multi-source Resonance Monitoring System - Environment Config
# ============================================================
# Copy this file to .env and fill in your values
# All API keys are optional - system runs in mock mode without them
# ============================================================

# Database
DB_PATH=./data/resonance.db

# API Keys (optional - mock mode when missing)
GEXMETRIX_API_KEY=
AXLFI_API_KEY=
CRYPTO_API_KEY=
DARKPOOL_API_KEY=

# JWT Authentication
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO

# Data Collection
FETCH_INTERVAL_SECONDS=60
FETCH_TIMEOUT_SECONDS=30
MAX_WORKERS=8
